{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winston-pickett.github.io/research-lab/data.schema.json",
  "title": "Finance Transformation Research Lab",
  "type": "object",
  "required": [
    "schemaVersion",
    "lastUpdated",
    "themes",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "theme",
        "themeLabel",
        "metric",
        "title",
        "finding",
        "coverage",
        "period",
        "published",
        "type",
        "studyYear",
        "source",
        "addedOn",
        "updatedOn",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]-[0-9]{2,}$"
        },
        "theme": {
          "enum": [
            "planning",
            "data",
            "ai",
            "operating",
            "risk",
            "cash"
          ]
        },
        "themeLabel": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "studyYear": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "source": {
          "type": "object",
          "required": [
            "publisher",
            "title",
            "url",
            "accessedOn"
          ],
          "properties": {
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "accessedOn": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "addedOn": {
          "type": "string",
          "format": "date"
        },
        "updatedOn": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "active",
            "archived",
            "superseded"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
